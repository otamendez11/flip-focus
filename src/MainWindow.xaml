<Window x:Class="PomodoroFlip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PomodoroFlip.Controls"
        Title="Flip Focus"
        Width="500" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1B1B1E" />
            <Setter Property="Foreground" Value="#EDEDEB" />
            <Setter Property="BorderBrush" Value="#2A2A2E" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#121214" />
            <Setter Property="Foreground" Value="#EDEDEB" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EDEDEB" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource ShellBg}" CornerRadius="20" BorderBrush="#16FFFFFF" BorderThickness="1">
        <Grid x:Name="RootGrid" Background="Transparent">

            <!-- ===== El reloj ===== -->
            <Border x:Name="ClockHost" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" Cursor="Hand">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="ClockScale" ScaleX="1" ScaleY="1" />
                </Border.LayoutTransform>
                <controls:FlipClock x:Name="Clock" />
            </Border>

            <!-- ===== Frase motivadora (aparece y se va sola) ===== -->
            <Border x:Name="QuoteBox" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="420" Background="#F50D0D0F" BorderBrush="#2AFFFFFF" BorderThickness="1"
                    CornerRadius="16" Padding="26,20">
                <StackPanel>
                    <TextBlock x:Name="QuoteText" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F0" LineHeight="21" />
                    <TextBlock x:Name="QuoteAuthor" TextAlignment="Center" FontSize="11.5"
                               Foreground="#9A9A98" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Barra de botones (aparece al pasar el mouse) ===== -->
            <StackPanel x:Name="HoverBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="10,10,10,0" Opacity="0" IsHitTestVisible="True">
                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                        Click="Pin_Click" ToolTip="{DynamicResource L.tip.pin}" />
                <Button x:Name="MiniButton" Style="{StaticResource IconButton}" Content="&#xE73F;"
                        Click="Mini_Click" ToolTip="{DynamicResource L.tip.mini}" />
                <Button x:Name="FullButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                        Click="Full_Click" ToolTip="{DynamicResource L.tip.full}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                        Click="Settings_Click" ToolTip="{DynamicResource L.tip.settings}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        Click="Hide_Click" ToolTip="{DynamicResource L.tip.hide}" />
            </StackPanel>

            <!-- ===== Panel de ajustes ===== -->
            <controls:SettingsPanel x:Name="Settings" Visibility="Collapsed" />

            <!-- ===== Aviso al entrar en pantalla completa ===== -->
            <Border x:Name="ShortcutHint" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
                    Background="#E6141417" BorderBrush="#24FFFFFF" BorderThickness="1"
                    CornerRadius="14" Padding="20,12" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="ShortcutHintTitle" Text="{DynamicResource L.hint.title}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ShortcutHintBody" Text="Space pause · F leaves · M shrinks · A settings"
                               FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ===== Menu del boton derecho ===== -->
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="PlayPauseItem" Header="{DynamicResource L.menu.play}" Click="PlayPause_Click" />
                    <MenuItem Header="{DynamicResource L.menu.reset}" Click="Reset_Click" />
                    <MenuItem Header="{DynamicResource L.menu.skip}" Click="Skip_Click" />
                    <MenuItem Header="{DynamicResource L.menu.restartcycle}" Click="ResetAll_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.menu.mini}" Click="Mini_Click" />
                    <MenuItem Header="{DynamicResource L.menu.normal}" Click="Normal_Click" />
                    <MenuItem Header="{DynamicResource L.tip.full}" Click="Full_Click" />
                    <Separator />
                    <MenuItem x:Name="NotifyItem" Header="{DynamicResource L.menu.notify}" IsCheckable="True" Click="Notify_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.menu.settings}" Click="Settings_Click" />
                    <MenuItem Header="{DynamicResource L.menu.exit}" Click="Exit_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</Window>
