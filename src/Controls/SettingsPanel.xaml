<UserControl x:Class="PomodoroFlip.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:PomodoroFlip.Services"
             xmlns:models="clr-namespace:PomodoroFlip.Models"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <svc:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <Border Background="#FF0D0D0F" CornerRadius="19">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Cabecera ===== -->
            <Grid Grid.Row="0" Margin="20,16,16,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.set.title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource L.set.subtitle}"
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Close_Click" ToolTip="{DynamicResource L.set.close}" />
            </Grid>

            <!-- ===== Cuerpo ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,16,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel>

                    <!-- IDIOMA -->
                    <TextBlock Text="{DynamicResource L.set.sec.language}" Style="{StaticResource SectionHeader}" />
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource L.set.language}" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{DynamicResource L.set.language.hint}" Style="{StaticResource SettingHint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <RadioButton Style="{StaticResource Segment}" Content="English" GroupName="Lang"
                                         IsChecked="{Binding AppLanguage, Converter={StaticResource EnumToBool}, ConverterParameter=English, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Español" GroupName="Lang"
                                         IsChecked="{Binding AppLanguage, Converter={StaticResource EnumToBool}, ConverterParameter=Spanish, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource Divider}" />

                    <!-- TIEMPOS -->
                    <TextBlock Text="{DynamicResource L.set.sec.times}" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="TimingSection">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.set.focus}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{DynamicResource L.set.focus.hint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="FocusMinus_Click" />
                                <TextBlock Text="{Binding FocusMinutes}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Click="FocusPlus_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.set.short}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{DynamicResource L.set.short.hint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="ShortMinus_Click" />
                                <TextBlock Text="{Binding ShortBreakMinutes}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Click="ShortPlus_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.set.long}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{DynamicResource L.set.long.hint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="LongMinus_Click" />
                                <TextBlock Text="{Binding LongBreakMinutes}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Click="LongPlus_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.set.cycles}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{DynamicResource L.set.cycles.hint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="CyclesMinus_Click" />
                                <TextBlock Text="{Binding CyclesBeforeLongBreak}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Click="CyclesPlus_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L.set.cycle.current}" Style="{StaticResource SettingLabel}" />
                                <TextBlock x:Name="CycleStatusText" Text="Sesion 1 de 4" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="{DynamicResource L.set.cycle.reset}"
                                    VerticalAlignment="Center" Click="RestartCycle_Click"
                                    ToolTip="{DynamicResource L.set.cycle.reset.tip}" />
                        </Grid>
                    </StackPanel>

                    <Rectangle Style="{StaticResource Divider}" />

                    <!-- COMPORTAMIENTO -->
                    <TextBlock Text="{DynamicResource L.set.sec.behaviour}" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.chain.breaks}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.chain.breaks.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartBreaks, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.chain.focus}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.chain.focus.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartFocus, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.bowl}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.bowl.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding SoundEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.volume}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.volume.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="VolumeMinus_Click" />
                            <TextBlock Text="{Binding VolumePercent}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Click="VolumePlus_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.quotes}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.quotes.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding MotivationalQuotes, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource L.set.notifications}" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{DynamicResource L.set.notifications.hint}" Style="{StaticResource SettingHint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.notif.never}" GroupName="Notif"
                                         IsChecked="{Binding NotificationMode, Converter={StaticResource EnumToBool}, ConverterParameter=Never, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.notif.hidden}" GroupName="Notif"
                                         IsChecked="{Binding NotificationMode, Converter={StaticResource EnumToBool}, ConverterParameter=OnlyWhenHidden, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.notif.always}" GroupName="Notif"
                                         IsChecked="{Binding NotificationMode, Converter={StaticResource EnumToBool}, ConverterParameter=Always, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L.set.notif.shortcut}" Style="{StaticResource SettingHint}" Margin="0,9,0,0" />
                    </StackPanel>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.sound.fullscreen}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.sound.fullscreen.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding PlaySoundInFullscreen, Mode=TwoWay}" />
                    </Grid>

                    <Rectangle Style="{StaticResource Divider}" />

                    <!-- VENTANA -->
                    <TextBlock Text="{DynamicResource L.set.sec.window}" Style="{StaticResource SectionHeader}" />

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource L.set.mode}" Style="{StaticResource SettingLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.mode.mini}" GroupName="Mode"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Mini, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.mode.normal}" GroupName="Mode"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Normal, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.mode.fullscreen}" GroupName="Mode"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Fullscreen, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource L.set.corner}" Style="{StaticResource SettingLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.corner.tl}" GroupName="Corner"
                                         IsChecked="{Binding AnchorCorner, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.corner.tr}" GroupName="Corner"
                                         IsChecked="{Binding AnchorCorner, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.corner.bl}" GroupName="Corner"
                                         IsChecked="{Binding AnchorCorner, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource L.set.corner.br}" GroupName="Corner"
                                         IsChecked="{Binding AnchorCorner, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.mini.size}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.mini.size.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="MiniMinus_Click" />
                            <TextBlock Text="{Binding MiniScalePercent}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Click="MiniPlus_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.normal.size}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.normal.size.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="NormalMinus_Click" />
                            <TextBlock Text="{Binding NormalScalePercent}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Click="NormalPlus_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.opacity}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.opacity.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StepButton}" Content="&#x2013;" Click="OpacityMinus_Click" />
                            <TextBlock Text="{Binding OpacityPercent}" Width="52" TextAlignment="Center" Style="{StaticResource SettingLabel}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Click="OpacityPlus_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.ontop}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.ontop.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                    </Grid>

                    <Rectangle Style="{StaticResource Divider}" />

                    <!-- RELOJ -->
                    <TextBlock Text="{DynamicResource L.set.sec.clock}" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.seconds}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.seconds.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowSeconds, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.flip}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.flip.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding FlipAnimation, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.hover}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.hover.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowControlsOnHover, Mode=TwoWay}" />
                    </Grid>

                    <Rectangle Style="{StaticResource Divider}" />

                    <!-- SISTEMA -->
                    <TextBlock Text="{DynamicResource L.set.sec.system}" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.autostart}" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="AutoStartHint" Text="{DynamicResource L.set.autostart.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.hotkeys}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.hotkeys.hint}" Style="{StaticResource SettingHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <RadioButton Style="{StaticResource Segment}" Content="Ctrl + Alt" GroupName="HotKeyMod"
                                             IsChecked="{Binding HotKeyModifier, Converter={StaticResource EnumToBool}, ConverterParameter=CtrlAlt, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Ctrl + Shift" GroupName="HotKeyMod"
                                             IsChecked="{Binding HotKeyModifier, Converter={StaticResource EnumToBool}, ConverterParameter=CtrlShift, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock x:Name="HotKeyHint" Text="Ctrl + Alt + P / M / F / A / R / C / N / H" Style="{StaticResource SettingHint}" Margin="0,9,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top"
                                      Margin="0,2,0,0" IsChecked="{Binding HotKeysEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource L.set.media}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{DynamicResource L.set.media.hint}" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding MediaKeyPlayPause, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource L.set.focused}" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{DynamicResource L.set.focused.hint}"
                                   Style="{StaticResource SettingHint}" />
                    </StackPanel>

                    <TextBlock x:Name="FooterText" Style="{StaticResource SettingHint}" Margin="0,6,0,16" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Pie ===== -->
            <Grid Grid.Row="2" Margin="20,10,16,16">
                <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.set.restore}"
                        HorizontalAlignment="Left" Click="Reset_Click" />
                <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.set.done}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
